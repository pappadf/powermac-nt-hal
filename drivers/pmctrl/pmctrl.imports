VideoPortGetDeviceBase
VideoPortInitialize
[ntoskrnl.exe]
ExAllocatePool
KeInitializeDpc
KeInitializeTimer
KeSetTimerEx
MmAllocateContiguousMemory
MmGetPhysicalAddress
RtlWriteRegistryValue
[HAL.dll]
HalDisplayString
